generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  TPO
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  PLACED
}


enum ScheduleType {
  BATCH
  BRANCH
}

enum AttendanceSection {
  MORNING
  AFTERNOON
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model College {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  users         User[]
  students      StudentProfile[]
  announcements Announcement[]

  @@index([is_deleted])
}

model User {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  username       String? // Encrypted
  username_hash  String? @unique
  email          String? // Encrypted
  email_hash     String? @unique
  phone          String? // Encrypted
  phone_hash     String?

  password   String
  role       Role
  college_id String @db.Uuid
  college    College @relation(fields: [college_id], references: [id], onDelete: Restrict)

  mustChangePassword Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  student_profile StudentProfile?
  faculty_profile FacultyProfile?
  announcements   Announcement[]

  @@index([email_hash])
  @@index([username_hash])
  @@index([role])
  @@index([college_id])
  @@index([is_deleted])
  @@index([id, role, college_id])
}

model FacultyProfile {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Redundant fields for easier access/display, synced with User
  name  String
  email String // Encrypted
  email_hash String?
  phone String? // Encrypted
  phone_hash String?

  assignedBranches String[] // e.g. ["CSE", "ECE"]
  assignedBatches  String[] // e.g. ["Batch A", "2024-2025"]

  schedules CRTSchedule[] // Relation to schedules

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  @@index([user_id])
  @@index([is_deleted])
}

model StudentProfile {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  college_id String  @db.Uuid
  college    College @relation(fields: [college_id], references: [id], onDelete: Restrict)

  roll_no       String // Encrypted
  roll_no_hash  String @unique
  branch    String
  year      Int
  cgpa      Float
  batch     String  @default("2024-2025")
  status    String  @default("Unplaced")
  is_crt    Boolean @default(false)
  crt_marks Float?

  crt_batch_id String?   @db.Uuid
  crt_batch    CRTBatch? @relation(fields: [crt_batch_id], references: [id])
  allocated_batch String?

  skills String[]

  resume_url  String?
  marks10_url String?
  marks12_url String?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  applications      Application[]
  placement_records PlacementRecord[]
  attendances       Attendance[]

  @@index([roll_no])
  @@index([branch])
  @@index([year])
  @@index([cgpa])
  @@index([college_id])
  @@index([is_deleted])
  @@index([crt_batch_id])
  @@index([user_id, college_id, is_crt, batch]) // Composite index for CRT filtering
}

model Announcement {
  id               String  @id @default(uuid()) @db.Uuid
  company_name     String
  job_role         String
  description      String
  application_link String?

  required_cgpa    Float?
  required_skills  String[]
  allowed_branches String[]
  package          String?  @default("N/A")
  is_crt_only      Boolean  @default(false)

  deadline DateTime @db.Timestamp(6)

  created_by String @db.Uuid
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Restrict)

  college_id String  @db.Uuid
  college    College @relation(fields: [college_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  applications Application[]

  @@index([deadline])
  @@index([company_name])
  @@index([created_by])
  @@index([college_id])
  @@index([required_cgpa])
  @@index([is_deleted])
}

model Application {
  id String @id @default(uuid()) @db.Uuid

  student_id String         @db.Uuid
  student    StudentProfile @relation(fields: [student_id], references: [id], onDelete: Restrict)

  announcement_id String       @db.Uuid
  announcement    Announcement @relation(fields: [announcement_id], references: [id], onDelete: Restrict)

  status     ApplicationStatus
  applied_at DateTime          @default(now()) @db.Timestamp(6)
  updated_at DateTime          @updatedAt @db.Timestamp(6)
  is_deleted Boolean           @default(false)

  @@unique([student_id, announcement_id])
  @@index([student_id])
  @@index([announcement_id])
  @@index([status])
  @@index([is_deleted])
}

model PlacementRecord {
  id String @id @default(uuid()) @db.Uuid

  student_id String         @db.Uuid
  student    StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  company_name     String
  package          Float?
  offer_letter_url String?

  placed_at  DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  @@index([student_id])
  @@index([company_name])
  @@index([placed_at])
  @@index([is_deleted])
}

model CRTBatch {
  id           String    @id @default(uuid()) @db.Uuid
  batch_name   String
  academic_year String   @default("2024-2025")
  trainer_name String?
  start_date   DateTime?  @db.Timestamp(6)
  end_date     DateTime? @db.Timestamp(6)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  is_deleted Boolean  @default(false)

  students    StudentProfile[]
  schedules   CRTSchedule[]

  @@index([is_deleted])
  @@index([academic_year])
}

model CRTSchedule {
  id            String         @id @default(uuid()) @db.Uuid
  type          ScheduleType
  academic_year String
  
  branch        String?
  batches       CRTBatch[]

  name          String
  start_date    DateTime       @db.Timestamp(6)
  end_date      DateTime       @db.Timestamp(6)
  room_no       String
  
  status        String         @default("Active")
  
  attendance_completed    Boolean        @default(false)
  attendance_completed_at DateTime?      @db.Timestamp(6)
  
  faculty       FacultyProfile[]
  attendances   Attendance[]

  created_at    DateTime       @default(now()) @db.Timestamp(6)
  updated_at    DateTime       @updatedAt @db.Timestamp(6)
  is_deleted    Boolean        @default(false)
  
  @@index([is_deleted])
  @@index([start_date])
  @@index([end_date])
  @@index([status, is_deleted]) // For filtering active schedules
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  
  student_id String           @db.Uuid
  student    StudentProfile   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  schedule_id String          @db.Uuid
  schedule    CRTSchedule     @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  date       DateTime         @db.Date
  section    AttendanceSection
  status     AttendanceStatus
  topic      String?

  marked_at  DateTime         @default(now()) @db.Timestamp(6)
  updated_at DateTime         @updatedAt @db.Timestamp(6)
  is_deleted Boolean          @default(false)

  @@unique([student_id, schedule_id, date, section])
  @@index([student_id])
  @@index([schedule_id])
  @@index([date])
  @@index([is_deleted])
  @@index([student_id, schedule_id, date, is_deleted]) // Critical index for session tracking
}
